# 填写服务商给出的 API 基础地址，一般以 /v1 结尾
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# 真题搜索、原文读取和核验使用 DeepSeek 官方服务
EXAM_DEEPSEEK_API_KEY=
# debug = 1 真题 + 1 模拟题，standard = 3 真题 + 7 模拟题
EXAM_QUIZ_MODE=debug

# 质疑题目时使用的独立审核服务
REVIEW_MODEL_BASE_URL=
REVIEW_MODEL_API_KEY=
REVIEW_MODEL_NAME=
# 留空时使用项目目录内的 .local/quiz.sqlite3
QUIZ_DB_PATH=
